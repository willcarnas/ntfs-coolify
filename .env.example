# ── Sistema de Trading (WCN) — variáveis de ambiente ──────────────────────────
# Copie para `.env` e preencha. NUNCA versione o .env com valores reais.

# Ambiente: desenvolvimento | producao
TRADING_ENV=desenvolvimento
# Modo mock global (1 = permite fontes simuladas onde previsto)
TRADING_MOCK=1

# Telegram (RF-10). Sem estes valores, os alertas ficam na fila e o serviço
# apenas reporta "degradado" — nenhuma outra função é afetada.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Token opcional da brapi.dev (aumenta limite de requisições). Vazio = uso anônimo.
BRAPI_TOKEN=

# Caminhos opcionais (padrões relativos à raiz do projeto)
# TRADING_DB_PATH=C:\caminho\trading.db
# TRADING_DATA_DIR=C:\caminho\data
# TRADING_BACKUP_DIR=C:\caminho\backups
# TRADING_LOG_DIR=C:\caminho\logs

# Limites de saúde (RF-14)
TRADING_LIMITE_CPU=90
TRADING_LIMITE_RAM=90
TRADING_LIMITE_DISCO=90

# Timeout padrão de chamadas externas (segundos)
TRADING_HTTP_TIMEOUT=15

# Execução única (teste manual de conector). Deixe 0 no uso normal.
TRADING_ONESHOT=0

# Testes manuais de alerta de saúde (RF-14)
# TRADING_TESTE_DISCO_CHEIO=1
# TRADING_TESTE_SEM_REDE=1
